<section class="pf2e-general-store pf2e-general-store-sale">
  <p>{{sourceName}} → {{payoutName}}</p>
  <ul>{{#each items}}<li data-item-id="{{id}}"><label><input type="checkbox" data-select-item checked><span>{{name}}</span><input data-quantity type="number" min="1" max="{{quantity}}" value="{{quantity}}" /></label></li>{{/each}}</ul>
  <p>{{localize "PF2EGeneralStore.Sale.Total"}}: <strong data-sale-total>{{total}}</strong></p>
  <button type="button" data-action="sell" {{#if busy}}disabled{{/if}}>{{localize "PF2EGeneralStore.Sale.Confirm"}}</button>
</section>
