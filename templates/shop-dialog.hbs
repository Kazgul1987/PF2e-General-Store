<section class="pf2e-general-store-dialog">
  <header class="store-controls">
    <div class="store-controls__header">
      <button class="store-logo {{#if isGM}}store-logo--clickable{{/if}}" type="button" data-action="logo">
        {{#if logoSrc}}<img class="store-logo__image" src="{{logoSrc}}" alt="{{logoAlt}}">{{else}}<span class="store-logo__placeholder">Logo</span>{{/if}}
      </button>
      <h1 class="store-title">{{localize "PF2EGeneralStore.Store.Title"}}</h1>
      <div class="store-context"><strong>{{localize "PF2EGeneralStore.Store.Active"}}</strong> {{activeStoreLabel}}</div>
    </div>
    <div class="store-controls__row">
      <div class="store-filters">
        <label class="store-option"><input data-filter type="checkbox" name="filter-spell" {{#if showSpells}}checked{{/if}}> Spell</label>
        <label class="store-option"><input data-filter type="checkbox" name="filter-item" {{#if showItems}}checked{{/if}}> Item</label>
        <label class="store-option"><select data-filter name="filter-item-type"><option value="">{{localize "PF2EGeneralStore.Common.All"}}</option><option value="weapon">Weapon</option><option value="armor">Armor</option><option value="equipment">Equipment</option><option value="shield">Shield</option><option value="consumable">Consumable</option><option value="treasure">Treasure</option><option value="backpack">Backpack</option></select></label>
        <label class="store-option"><input data-filter type="checkbox" name="filter-sort-alpha" {{#if sortAlpha}}checked{{/if}}> {{localize "PF2EGeneralStore.Store.SortAlpha"}}</label>
      </div>
      <div class="store-search"><input type="search" name="store-search" value="{{searchTerm}}" placeholder="{{localize "PF2EGeneralStore.Store.Search"}}"></div>
      <div class="store-cart">
        <button type="button" data-action="addCart"><i class="fas fa-shopping-cart"></i> {{localize "PF2EGeneralStore.Cart.Add"}}</button>
        <button type="button" data-action="addWishlist"><i class="fas fa-heart"></i> {{localize "PF2EGeneralStore.Wishlist.Add"}}</button>
        <button type="button" data-action="viewWishlist">{{localize "PF2EGeneralStore.Wishlist.View"}}</button>
        <button type="button" data-action="sell"><i class="fas fa-coins"></i> {{localize "PF2EGeneralStore.Sale.Open"}}</button>
        <span>{{localize "PF2EGeneralStore.Cart.Title"}}: <strong>{{cartTotal}}</strong></span>
      </div>
      <div class="store-availability"><span>{{actorName}}: {{actorGold}}</span><span>{{localize "PF2EGeneralStore.Store.PartyStash"}}: {{partyGold}}</span></div>
    </div>
  </header>
  <div class="store-main store-body">
    <div class="store-results"><ul>
      {{#each results}}
        <li class="store-result"><button class="store-result__button {{#if selected}}selected{{/if}}" type="button" data-action="selectResult" data-pack="{{pack}}" data-item-id="{{itemId}}"><img class="store-result__icon" src="{{icon}}" alt=""><span class="store-result__details"><span class="store-result__name">{{name}}</span><span>Level {{level}}</span></span><span class="store-result__price">{{totalLabel}}</span></button></li>
      {{else}}<li class="placeholder">{{localize "PF2EGeneralStore.Store.NoResults"}}</li>{{/each}}
    </ul></div>
    <section class="store-description"><div class="store-description__content">{{#if description}}{{{description}}}{{else}}<p class="store-description__placeholder">{{localize "PF2EGeneralStore.Store.SelectDescription"}}</p>{{/if}}</div></section>
  </div>
  <section class="pf2e-general-store-cart-dialog">
    <ul class="cart-dialog__items">{{#each cart}}<li class="cart-dialog__item" data-cart-key="{{key}}"><span>{{name}} ×{{quantity}}</span><span>{{totalLabel}}</span><button type="button" data-action="removeCart" aria-label="{{localize "PF2EGeneralStore.Cart.Remove"}}">×</button></li>{{/each}}</ul>
    {{#if cart.length}}<label><input type="radio" name="payment-source" value="actor" checked> {{actorName}}</label><label><input type="radio" name="payment-source" value="party"> {{localize "PF2EGeneralStore.Store.PartyStash"}}</label><button type="button" data-action="checkout">{{localize "PF2EGeneralStore.Cart.Checkout"}}</button>{{/if}}
  </section>
</section>
