<form class="pf2e-general-store-gm">
  <p>{{localize "PF2EGeneralStore.Filters.Menu"}}</p>
  <p>{{localize "PF2EGeneralStore.Filters.Description"}}</p>

  <div class="form-group">
    <label for="pf2e-general-store-traits">{{localize "PF2EGeneralStore.Filters.Traits"}}</label>
    <input
      id="pf2e-general-store-traits"
      type="text"
      name="gm-traits"
      placeholder="{{localize "PF2EGeneralStore.Filters.TraitsPlaceholder"}}"
      value="{{traitsInput}}"
    />
    <p class="hint">{{localize "PF2EGeneralStore.Filters.TraitsHint"}}</p>
  </div>

  <div class="form-group">
    <label for="pf2e-general-store-min-level">{{localize "PF2EGeneralStore.Filters.MinLevel"}}</label>
    <input
      id="pf2e-general-store-min-level"
      type="number"
      name="min-level"
      placeholder="{{localize "PF2EGeneralStore.Common.None"}}"
      value="{{minLevel}}"
    />
  </div>

  <div class="form-group">
    <label for="pf2e-general-store-max-level">{{localize "PF2EGeneralStore.Filters.MaxLevel"}}</label>
    <input
      id="pf2e-general-store-max-level"
      type="number"
      name="max-level"
      placeholder="{{localize "PF2EGeneralStore.Common.None"}}"
      value="{{maxLevel}}"
    />
  </div>

  <div class="form-group">
    <label for="pf2e-general-store-rarity">{{localize "PF2EGeneralStore.Filters.Rarity"}}</label>
    <select id="pf2e-general-store-rarity" name="rarity">
      {{#each rarityOptions}}
        <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>
          {{this.label}}
        </option>
      {{/each}}
    </select>
  </div>

  <hr />
  <footer class="pf2e-general-store-gm__actions">
    <button type="button" data-action="manageStores">{{localize "PF2EGeneralStore.Filters.ManageStores"}}</button>
    <button type="button" data-action="wishlist">{{localize "PF2EGeneralStore.Filters.GlobalWishlist"}}</button>
    <button type="button" data-action="save">{{localize "PF2EGeneralStore.Filters.Save"}}</button>
    <button type="button" data-action="openStore">{{localize "PF2EGeneralStore.Filters.OpenStore"}}</button>
  </footer>
</form>
